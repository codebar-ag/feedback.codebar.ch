APP_NAME="codebar Feedback"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# sqlite (local), mysql/mariadb or pgsql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=feedback
# DB_USERNAME=feedback
# DB_PASSWORD=
# DB_READ_HOST=        # optional read replica, defaults to DB_HOST
# DB_WRITE_HOST=       # optional, defaults to DB_HOST
# DB_SSLMODE=require   # managed PostgreSQL such as Neon

# Rate limiting uses the cache store: file (single server) or database/redis (several instances).
CACHE_STORE=file

# Comma separated proxy IPs/CIDRs (load balancer, CDN). Empty = trust none.
TRUSTED_PROXIES=

# Base URL of this API as used by the widget, e.g. https://feedback.codebar.ch
FEEDBACK_ENDPOINT="${APP_URL}"

# black | white | #RRGGBB, used when a project has no color
FEEDBACK_DEFAULT_COLOR=black

# Rate limits and minimum fill time. Defaults: 10 per IP/min, 60 per project/min,
# 2000 ms. Uncomment to change, 0 switches a limit off.
# FEEDBACK_LIMIT_PER_IP_PER_MINUTE=10
# FEEDBACK_LIMIT_PER_PROJECT_PER_MINUTE=60
# FEEDBACK_MIN_ELAPSED_MS=2000

# Oh Dear application health monitoring (spatie/laravel-health)
OH_DEAR_HEALTH_CHECK_ENABLED=true
OH_DEAR_HEALTH_CHECK_SECRET=
OH_DEAR_HEALTH_CHECK_PATH=/oh-dear-health-check-results

# Optional: health check fails while Nightwatch has an open issue.
# Token: `php artisan nightwatch:login`; IDs: application/environment IDs from Nightwatch (list_applications / list_environments).
NIGHTWATCH_API_TOKEN=
NIGHTWATCH_APPLICATION_ID=
NIGHTWATCH_ENVIRONMENT_ID=

CODEBAR_ANALYTICS_URL=https://analytics.codebar.ch
