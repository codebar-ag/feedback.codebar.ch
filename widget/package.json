{
  "name": "codebar-feedback-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Feedback widget, served by the API at /widget/v1/feedback.js. Vanilla TypeScript, Shadow DOM.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run build && node --experimental-strip-types tests/e2e/server.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../e2e/tsconfig.json",
    "lint": "eslint . && prettier --check . \"../e2e/*.{ts,json}\" \"../e2e/fixtures/**\"",
    "format": "prettier --write . \"../e2e/*.{ts,json}\" \"../e2e/fixtures/**\" && eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:full": "NODE_PATH=$PWD/node_modules playwright test -c ../e2e/playwright.config.ts",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "size-limit": "14.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "modern-screenshot": "4.7.0"
  }
}
